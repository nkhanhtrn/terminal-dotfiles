" Airline
" statusline: full file path relative to the folder vim was launched from
function! AirlineRootPath()
    let l:name = bufname('%')
    if empty(l:name)
        return '[No Name]'
    endif
    if &buftype !=# ''
        return l:name
    endif
    let l:path = fnamemodify(l:name, ':p')
    let l:root = g:vim_start_dir . '/'
    if l:path[:len(l:root)-1] ==# l:root
        return l:path[len(l:root):]
    endif
    return fnamemodify(l:path, ':~')
endfunction
let g:airline_section_c = '%{AirlineRootPath()}%m'
