" Open Rg result(s) in new vim tab(s); lines = [key, file:line:col:text, ...]
function! RgOpenInTab(lines)
    if len(a:lines) < 2
        return
    endif
    " resolve every path while cwd is still the dir rg ran in (BufEnter lcd
    " in the vimrc would otherwise break relative paths of later results)
    let l:targets = []
    for line in a:lines[1:]
        let m = matchlist(line, '^\(.\{-}\):\(\d\+\):\(\d\+\):')
        if empty(m)
            let m = matchlist(line, '^\(.\{-}\):\(\d\+\):')
            if empty(m)
                continue
            endif
            call add(l:targets, [fnamemodify(m[1], ':p'), str2nr(m[2]), 1])
        else
            call add(l:targets, [fnamemodify(m[1], ':p'), str2nr(m[2]), str2nr(m[3])])
        endif
    endfor
    for [file, lnum, col] in l:targets
        call TabGoOrOpen(file)
        call cursor(lnum, col)
        normal! zvzz
    endfor
endfunction

command! -bang -nargs=? -complete=dir Rg
