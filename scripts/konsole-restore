#!/bin/bash
# konsole-restore: reopen one Konsole tab per tmux session.
#
# On a fresh boot (no tmux server) it bootstraps the server so tmux-continuum
# auto-restores the saved sessions (windows, panes and their cwds), then opens
# a Konsole window with one tab per session, attached to exactly that session.
# Use this as your terminal launcher.

BOOTSTRAP=""
if ! tmux has-session 2>/dev/null; then
    # a server with zero sessions exits immediately, so keep a placeholder
    # alive while continuum does its restore pass
    tmux new-session -d -s _restore_boot 2>/dev/null
    for _ in $(seq 1 20); do
        n=$(tmux ls -F '#{session_name}' 2>/dev/null | grep -vc '^_restore_boot$' || true)
        [ "${n:-0}" -gt 0 ] && break
        sleep 0.5
    done
    BOOTSTRAP=1
fi

f=$(mktemp /tmp/konsole-tabs.XXXXXX)
tmux ls -F '#{session_name}' 2>/dev/null \
    | grep -v '^_restore_boot$' | sort -V \
    | while read -r s; do
        printf 'title: %s;; command: tmux attach -t %s\n' "$s" "$s" >> "$f"
      done

[ -n "$BOOTSTRAP" ] && tmux kill-session -t _restore_boot 2>/dev/null

if [ -s "$f" ]; then
    exec konsole --tabs-from-file "$f"
else
    exec konsole
fi
