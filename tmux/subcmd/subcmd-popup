#!/data/data/com.termux/files/usr/bin/sh
# subcmd-popup [pane_id] — fzf picker of subcommands for the command
# currently typed in the pane; inserts the choice into the command line.
# Meant to be launched from tmux:  display-popup -E subcmd-popup '<pane>'

CONF="$HOME/.config/subcmd"
. "$CONF/lib.sh"
export PATH="$CONF:$PATH"

pane="${1:-}"
[ -z "$pane" ] && pane=$(tmux display-message -p '#{pane_id}' 2>/dev/null)
[ -z "$pane" ] && { tmux display-message 'subcmd: no target pane'; exit 1; }

words=$(get_words "$pane")
word="${words%% *}"
pref="${words#* }"
[ "$pref" = "$word" ] && pref=""   # only one word typed

case "$word" in
    "" | */* | -* | .*)
        tmux display-message "subcmd: type a command first"
        exit 0
        ;;
esac

sel=$(suggest "$word" "" 2>/dev/null \
    | fzf --prompt="$word ❯ " --query="$pref" --reverse --no-info \
          --height=100% --no-clear 2>/dev/null)

[ -n "$sel" ] || exit 0

# wipe the partially-typed prefix before inserting the full subcommand
n=${#pref}
while [ "$n" -gt 0 ]; do
    tmux send-keys -t "$pane" BSpace
    n=$((n - 1))
done
tmux send-keys -t "$pane" -l -- "$sel "
