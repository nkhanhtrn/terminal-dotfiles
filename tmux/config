# -- basics -----------------------------------------------------------------
set -g mouse on
set-option -g default-shell ZSH_PATH
set -sg escape-time 0
set -g default-terminal "tmux-256color"
set -ga terminal-overrides ",xterm-256color:Tc"
set -g history-limit 50000

# new windows/panes start in the current pane's working directory
bind c new-window -c "#{pane_current_path}"
bind '"' split-window -c "#{pane_current_path}"
bind % split-window -h -c "#{pane_current_path}"

# prefix+m: toggle mouse (off => terminal handles taps, e.g. opening links in Termux)
bind m set -g mouse \; display 'mouse: #{?mouse,on,off}'

# copy selection to system clipboard on mouse release
set -s set-clipboard on
bind -T copy-mode MouseDragEnd1Pane send -X copy-pipe-and-cancel "wl-copy"
bind -T copy-mode-vi MouseDragEnd1Pane send -X copy-pipe-and-cancel "wl-copy"

# Termux-specific extras (open pane URLs in external browser, etc.)
if-shell '[ -f ~/.tmux.conf.termux ]' 'source-file ~/.tmux.conf.termux'

# -- yazi file-tree sidebar --------------------------------------------------
# prefix+t toggles a 30-column yazi sidebar on the left, rooted at the
# focused pane's working directory. The sidebar pane id is kept in the
# window option @yazi_pane; quitting yazi with q leaves it stale, so the
# next toggle just clears it (press prefix+t again to reopen).
bind t if -F '#{!=:#{@yazi_pane},}' \
    'run "tmux kill-pane -t \"#{@yazi_pane}\" 2>/dev/null; tmux set -w @yazi_pane \"\""' \
    'run "tmux set -w @yazi_pane \"$(tmux split-window -h -b -l 30 -c \"#{pane_current_path}\" -P -F \"#{pane_id}\" yazi)\""'

# -- plugin manager (tpm) ---------------------------------------------------
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'

# session save / restore
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'

# resurrect: capture pane scrollback + restore common programs
# (~) means "don't restore if not running in the right context"
set -g @resurrect-capture-pane-contents 'on'
set -g @resurrect-strategy-nvim 'session'
set -g @resurrect-processes 'ssh psql mysql sqlite3 ~vim ~nvim mosh tail ~btop ~htop ~lazygit'

# continuum: auto-save every 15 min, auto-restore on tmux server start
set -g @continuum-restore 'on'
set -g @continuum-save-interval '15'

# initialize tpm (keep at the very bottom)
run '~/.tmux/plugins/tpm/tpm'
