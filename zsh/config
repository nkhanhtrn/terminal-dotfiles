### bling.sh source end

# --- auto-start tmux: Termux always lands in one shared session ----------
# Reopening the app attaches to the existing 'main' session (restored by
# tmux-continuum); one is created only if none exists.
if [[ -n "$TERMUX_VERSION" && -z "$TMUX" && -o interactive ]]; then
    command -v tmux &>/dev/null && exec tmux new-session -A -s main
fi

# --- auto-start tmux: one unique session per terminal tab -----------------
# Each Konsole tab/window gets its own session (main, main-1, main-2, ...).
# All sessions are auto-saved by tmux-continuum and restored on next boot.
# Skipped when already inside tmux or inside an editor's embedded terminal.
if [[ -z "$TMUX" ]] && [[ -o interactive ]]; then
    if [[ -z "$VSCODE_IPC_HOOK" && -z "$INSIDE_EMACS" && -z "$TERM_PROGRAM" ]]; then
        if command -v tmux &>/dev/null; then
            _ocd_sess=main
            _ocd_n=1
            while tmux has-session -t "$_ocd_sess" 2>/dev/null; do
                _ocd_sess="main-$_ocd_n"
                _ocd_n=$((_ocd_n + 1))
            done
            exec tmux new-session -s "$_ocd_sess"
        fi
    fi
fi

